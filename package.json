{
  "name": "portfolio-kondo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "deploy:proposals": "pnpm build && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.8",
    "typescript": "^6.0.3",
    "wrangler": "^4.164.0"
  }
}
