---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | ポートフォリオ提案</title>
  </head>
  <body><main><slot /></main></body>
</html>
<style is:global>
  html { color-scheme: dark; background: #0d0e10; color: #e6e4df; font-family: system-ui, sans-serif; }
  body { margin: 0; }
  main { max-width: 56rem; margin: 0 auto; padding: 4rem 1.5rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.5; }
  p { line-height: 1.9; }
  a { color: inherit; text-underline-offset: .3em; }
  a:focus-visible { outline: 2px solid #e6e4df; outline-offset: 5px; }
  li { padding: .75rem 0; }
</style>
