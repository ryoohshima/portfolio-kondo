---
import "../styles/sampleEffects.css";
interface Props { title: string; number: number; theme: "dark" | "paper" | "gallery" }
const { title, number, theme } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | RYOSUKE KONDO ポートフォリオ・サンプル</title>
  </head>
  <body class={theme}>
    <div class="proposal-bar">
      <a href="/">提案一覧</a>
      <span>UKRAINE / REPORTAGE</span>
      <nav aria-label="デザイン案の切り替え">
        {[1, 2, 3].map((n) => <a href={`/sample-${n}/`} aria-current={n === number ? "page" : undefined}>案 {n}</a>)}
      </nav>
    </div>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header wrap">
      <a class="identity" href={`/sample-${number}/`}><strong>RYOSUKE KONDO<span>.</span></strong><small>JOURNALIST</small></a>
      <nav class="site-nav" aria-label="メインナビゲーション"><a href="#work">取材・記事</a><a href="#about">プロフィール</a><a href="#contact">お問い合わせ <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap" id="contact">
      <div><p class="small-label">GET IN TOUCH</p><h2>ウクライナの記録を、届ける。</h2><p>ウクライナでの取材・執筆について。</p></div>
      <div class="footer-bottom"><span>RYOSUKE KONDO</span><span>UKRAINE / REPORTAGE</span><a href="/">3案を比較する ↗</a></div>
    </footer>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 1rem; }
  body { margin: 0; font-family: "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif; line-height: 1.8; -webkit-font-smoothing: antialiased; }
  body.dark { --bg:#101311; --ink:#e6e8df; --muted:#a5ada3; --line:#3b433b; --accent:#c9ad74; background:var(--bg); color:var(--ink); color-scheme:dark; }
  body.paper { --bg:#f4f2eb; --ink:#252824; --muted:#64685f; --line:#c9ccc0; --accent:#7a3c2d; background:var(--bg); color:var(--ink); color-scheme:light; }
  body.gallery { --bg:#f6f7f4; --ink:#1c3129; --muted:#5e6b64; --line:#cbd3cb; --accent:#305c48; background:var(--bg); color:var(--ink); color-scheme:light; }
  a { color:inherit; text-decoration:none; } a:hover { color:var(--accent); } a:focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  img { display:block; width:100%; height:auto; object-fit:cover; }
  h1,h2,h3,p,figure { margin:0; } h1,h2,h3 { font-weight:400; }
  .serif { font-family: "Yu Mincho", "Hiragino Mincho ProN", "Noto Serif CJK JP", Georgia, serif; }
  .wrap { width:min(1280px, calc(100% - 96px)); margin-inline:auto; }
  .proposal-bar { min-height:36px; display:flex; justify-content:space-between; align-items:center; gap:16px; padding:6px 24px; font-size:10px; letter-spacing:.04em; border-bottom:1px solid var(--line); }
  .proposal-bar nav { display:flex; gap:16px; white-space:nowrap; } .proposal-bar a[aria-current="page"] { text-decoration:underline; text-underline-offset:4px; font-weight:700; }
  .site-header { display:flex; justify-content:space-between; align-items:center; min-height:100px; gap:24px; }
  .identity { display:flex; align-items:center; gap:22px; } .identity strong { font-size:22px; letter-spacing:.08em; font-weight:500; line-height:1; } .identity strong span { color:var(--accent); } .identity small { font-size:9px; letter-spacing:.12em; }
  .site-nav { display:flex; gap:32px; font-size:12px; } .site-nav a:last-child { border-bottom:1px solid var(--muted); }
  .small-label { font-size:10px; letter-spacing:.15em; font-weight:500; }
  .section-title { font-size:36px; line-height:1.5; } .section-head { margin-bottom:32px; } .section-head p { color:var(--muted); font-size:12px; margin-top:8px; }
  .meta { color:var(--muted); font-size:11px; letter-spacing:.05em; } .accent { color:var(--accent); }
  .site-footer { padding-top:65px; border-top:1px solid var(--line); margin-top:100px; }
  .site-footer h2 { font-family:"Yu Mincho", Georgia, serif; font-size:36px; margin:16px 0; } .site-footer p:not(.small-label) { font-size:13px; color:var(--muted); } .contact-placeholder { margin-top:12px; }
  .footer-bottom { margin-top:65px; padding:22px 0; border-top:1px solid var(--line); display:flex; justify-content:space-between; gap:20px; font-size:10px; color:var(--muted); }
  .skip-link { position:absolute; top:-100px; left:16px; padding:10px; background:var(--bg); z-index:20; } .skip-link:focus { top:40px; }
  @media(max-width:900px) { .wrap { width:calc(100% - 48px); } .identity small { display:none; } .site-nav { gap:20px; } }
  @media(max-width:600px) { .wrap { width:calc(100% - 36px); } .proposal-bar { padding-inline:18px; gap:10px; } .proposal-bar>span { display:none; } .site-header { min-height:90px; align-items:flex-start; padding-block:20px; flex-direction:column; gap:18px; } .identity strong { font-size:21px; } .site-nav { width:100%; justify-content:space-between; font-size:11px; gap:12px; } .section-title { font-size:28px; } .site-footer { margin-top:64px; padding-top:40px; } .site-footer h2 { font-size:28px; } .footer-bottom { flex-direction:column; gap:8px; margin-top:35px; } }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
</style>
