---
import ProposalLayout from "../layouts/ProposalLayout.astro";
---
<ProposalLayout title="提案一覧">
  <p class="eyebrow">KONDO / PORTFOLIO CONCEPTS</p>
  <h1>伝え方を、3つの視点から。</h1>
  <p class="introduction">RYOSUKE KONDOさんのウクライナ取材を伝える、トップページのラフ3案です。<br />構成・色・写真の見せ方を比較してください。</p>
  <div class="concepts">
    <a class="concept dark-concept" href="/sample-1/"><div class="preview"><span class="serif">戦争のなかの、<br />日常を伝える。</span><img src="/images/saltivka.jpg" width="1800" height="1200" alt="Saltivkaの集合住宅" /></div><div class="description"><span class="number">01 / FIELD REPORT</span><h2>ウクライナの現場から。</h2><p>ダークな誌面と実際の取材写真。<br />戦争の記録を正面から伝える。</p><span class="open">この案を見る ↗</span></div></a>
    <a class="concept paper-concept" href="/sample-2/"><div class="preview"><span class="serif">戦争のなかにある、<br />日常を見つめて。</span><img src="/images/kharkiv-afternoon.jpg" width="1200" height="800" alt="ハルキウの公園" /></div><div class="description"><span class="number">02 / COVER STORY</span><h2>一枚の写真から、物語へ。</h2><p>大きな写真に見出しを重ねる表紙型。<br />その下に横長の記事リストを配置。</p><span class="open">この案を見る ↗</span></div></a>
    <a class="concept gallery-concept" href="/sample-3/"><div class="preview"><span class="serif">RYOSUKE<br />KONDO.</span><img src="/images/kharkiv-night.jpg" width="1000" height="667" alt="損傷した建物" /></div><div class="description"><span class="number">03 / FIELD ARCHIVE</span><h2>人と記録を、並べて見せる。</h2><p>左にプロフィール、右に取材写真。<br />縦の軸で見せるアーカイブ型。</p><span class="open">この案を見る ↗</span></div></a>
  </div>
  <p class="notice">トップページのデザイン3案です。</p>
</ProposalLayout>
<style>
  .eyebrow { font-size:10px; letter-spacing:.15em; color:#a5ada3; }
  h1 { font-family:"Yu Mincho", "Hiragino Mincho ProN", Georgia, serif; font-weight:400; font-size:clamp(26px,4vw,40px); line-height:1.6; margin:22px 0; }
  .introduction { color:#b2b7af; font-size:13px; line-height:2; }
  .concepts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; margin-top:48px; }
  .concept { display:block; text-decoration:none; border:1px solid #3c443c; transition:border-color .2s; } .concept:hover { border-color:#c9ad74; }
  .preview { height:235px; padding:24px; overflow:hidden; } .preview .serif { display:block; font-family:"Yu Mincho", Georgia, serif; font-size:20px; line-height:1.7; } .preview img { width:100%; height:110px; object-fit:cover; display:block; margin-top:20px; }
  .dark-concept .preview { background:#101311; color:#e6e8df; } .paper-concept .preview { position:relative; background:#18201d; color:#fff; display:flex; align-items:end; } .paper-concept .preview::after { content:""; position:absolute; inset:0; background:linear-gradient(0deg,rgb(0 0 0 / .8),transparent); } .paper-concept .preview .serif { position:relative; z-index:1; font-size:19px; } .paper-concept .preview img { position:absolute; inset:0; width:100%; height:100%; margin:0; } .gallery-concept .preview { background:#f6f7f4; color:#1c3129; display:grid; grid-template-columns:1fr 1.4fr; align-items:start; gap:12px; padding:20px 12px; } .gallery-concept .preview .serif { font-family:Arial,sans-serif; font-size:12px; line-height:1.2; margin-top:8px; } .gallery-concept .preview img { width:100%; height:175px; margin:0; }
  .description { padding:24px 20px; } .number { font-size:9px; letter-spacing:.1em; color:#c9ad74; } .description h2 { font-size:17px; font-weight:400; margin:14px 0; } .description p { font-size:11px; line-height:2; color:#b2b7af; } .open { display:block; font-size:11px; margin-top:22px; } .notice { margin-top:35px; color:#a5ada3; font-size:10px; line-height:2; }
  @media(max-width:700px) { .concepts { grid-template-columns:1fr; } .preview { height:260px; } .preview img { height:145px; } }
  @media(prefers-reduced-motion:reduce) { .concept { transition:none; } }
</style>
