---
import SampleLayout from "../../layouts/SampleLayout.astro";
import { biography, reports } from "../../data/reports";
const [latest, saltivka, night] = reports;
---
<SampleLayout title="案1 / Field Report" number={1} theme="dark">
  <section class="hero wrap">
    <div class="hero-copy"><p class="small-label accent">REPORTING FROM UKRAINE</p><h1 class="serif">戦争のなかの、<br />日常を伝える。</h1><p class="intro">ウクライナを歩き、見つめ、書く。<br />戦時下の暮らしを伝えるルポルタージュ。</p><div class="signature"><span class="serif">RYOSUKE KONDO</span><span>ジャーナリスト</span></div><a class="text-link" href="#work">ウクライナルポを読む <span aria-hidden="true">↗</span></a></div>
    <figure class="hero-photo"><div class="photo-window"><img src={saltivka.image} width="1280" height="670" alt={saltivka.alt} fetchpriority="high" /></div><figcaption>ハルキウ / Saltivka · ウクライナルポ #15<span>UKRAINE</span></figcaption></figure>
  </section>
  <section id="work" class="reports wrap">
    <div class="section-head"><h2 class="section-title serif">ウクライナからの報告</h2><p>REPORTS FROM UKRAINE</p></div>
    <div class="report-grid">
      <article class="featured"><div class="photo-window"><img src={latest.image} width="1280" height="670" alt={latest.alt} loading="lazy" /></div><div class="meta">{latest.date} <span>{latest.location} / {latest.series}</span></div><h3 class="serif">{latest.title}</h3></article>
      <div class="report-list">{[saltivka, night].map(report => <article><p class="meta">{report.date} / {report.series}</p><h3 class="serif">{report.title}</h3><p>{report.location}</p></article>)}</div>
    </div>
  </section>
  <section id="about" class="about wrap"><p class="small-label accent">ABOUT THE JOURNALIST</p><h2 class="serif">戦争とは何か。<br />戦時下で暮らすとは。</h2><div><p>{biography}</p></div></section>
</SampleLayout>
<style>
  .hero { display:grid; grid-template-columns:.9fr 1.1fr; gap:40px; padding-top:28px; padding-bottom:70px; }
  .hero-copy { padding-top:35px; } h1 { font-size:clamp(40px,4.8vw,68px); line-height:1.65; letter-spacing:.06em; margin:28px 0 24px; }
  .intro { color:var(--muted); font-size:14px; line-height:2.2; } .signature { display:flex; align-items:center; gap:20px; margin-top:32px; } .signature>.serif { font-size:19px; letter-spacing:.04em; } .signature>span:last-child { font-size:10px; color:var(--muted); }
  .text-link { display:inline-flex; gap:60px; padding-bottom:12px; border-bottom:1px solid var(--line); margin-top:35px; font-size:12px; }
  .hero-photo img { height:560px; object-position:45% center; } figcaption { display:flex; justify-content:space-between; font-size:10px; padding-top:14px; color:var(--muted); } figcaption span { letter-spacing:.1em; font-size:9px; }
  .reports { padding-top:40px; border-top:1px solid var(--line); } .report-grid { display:grid; grid-template-columns:1.15fr 1fr; gap:64px; } .featured img { height:310px; } .featured .meta { margin-top:20px; } .featured .meta span { margin-left:24px; } .featured h3 { font-size:30px; line-height:1.6; margin:14px 0; } .featured .read-original { font-size:13px; color:var(--muted); max-width:36em; }
  .report-list article { padding:0 0 30px; margin-bottom:30px; border-bottom:1px solid var(--line); } .report-list h3 { font-size:26px; line-height:1.7; margin:16px 0 12px; } .report-list article>p:last-child { font-size:12px; color:var(--muted); }
  .about { display:grid; grid-template-columns:1fr 1fr; gap:30px 64px; margin-top:100px; padding-top:45px; border-top:1px solid var(--line); } .about>.small-label { grid-column:1/-1; } .about h2 { font-size:30px; line-height:1.9; } .about>div p { font-size:13px; color:var(--muted); line-height:2.2; } .about .meta { margin-top:20px; }
  @media(max-width:900px) { .hero { gap:28px; } h1 { font-size:43px; } .hero-photo img { height:510px; } .report-grid { gap:32px; } }
  @media(max-width:600px) { .hero { grid-template-columns:1fr; padding-top:10px; padding-bottom:40px; } .hero-copy { padding-top:10px; } h1 { font-size:clamp(30px,10vw,43px); margin:20px 0; } .hero-photo img { height:340px; } .report-grid,.about { grid-template-columns:1fr; } .featured img { height:240px; } .reports { padding-top:28px; } .featured h3,.report-list h3 { font-size:26px; } .report-list { margin-top:10px; } .about { margin-top:55px; padding-top:30px; } .about h2 { font-size:25px; } }
</style>
